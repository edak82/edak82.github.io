library(palmerpenguins)
library(tidyverse)
library(dplyr)
library(ggplot2)
penguin_clean <- penguins |> drop_na()
penguin_clean
#| label: fig-penguin-mass
#| fig-cap: "Body mass of penguins by species."
sorted_penguins <- penguin_clean |>
arrange(bill_depth_mm + flipper_length_mm)
#| label: fig-penguin-mass
#| fig-cap: "Body mass of penguins by species."
sorted_penguins <- penguin_clean |>
arrange(bill_depth_mm + flipper_length_mm)
sorted_penguins
#| label: fig-penguin-mass
#| fig-cap: "Body mass of penguins by species."
sorted_penguins <- penguin_clean |>
arrange(bill_length_mm + bill_depth_mm)
sorted_penguins
#| label: fig-penguin-mass
#| fig-cap: "Body mass of penguins by species."
sorted_penguins <- penguin_clean |>
arrange(bill_length_mm * bill_depth_mm)
sorted_penguins
#| label: fig-penguin-mass
#| fig-cap: "Body mass of penguins by species."
sorted_penguins <- penguin_clean |>
mutate(bill_size_mm_squared = bill_length_mm * bill_depth_mm)
sorted_penguins
#| label: fig-penguin-mass
#| fig-cap: "Body mass of penguins by species."
sorted_penguins <- penguin_clean |>
mutate(bill_size_mm_squared = bill_length_mm * bill_depth_mm) |>
arrange(bill_size_mm_squared)
sorted_penguins
#| label: fig-penguin-beak-size
#| fig-cap: "Beak size of penguins by species."
ggplot(sorted_penguins, aes(x = species, y = bill_size_mm_squared)) +
geom_boxplot()
sorted_penguins <- penguin_clean |>
mutate(bill_size_mm_squared = bill_length_mm * bill_depth_mm / 2) |>
arrange(bill_size_mm_squared)
sorted_penguins
#| label: fig-penguin-beak-size
#| fig-cap: "Beak size of penguins by species."
ggplot(sorted_penguins, aes(x = species, y = bill_size_mm_squared)) +
geom_boxplot()
renv::snapshot()
